# Copie para .env e preencha. NUNCA versione o .env.

# --- Cato (token SOMENTE LEITURA) ---
CATO_API_KEY=troque-pelo-token-somente-leitura
CATO_ACCOUNT_ID=1234567
# CATO_API_URL=https://api.catonetworks.com/api/v1/graphql2

# --- Teams (URL do fluxo "Post to a channel when a webhook request is received") ---
TEAMS_WEBHOOK_URL=https://exemplo.logic.azure.com/workflows/xxxx

# --- Heartbeat externo (Healthchecks.io ou compatível) ---
HEARTBEAT_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# --- Ajustes (valores padrão) ---
# INTERVALO_SEGUNDOS: 30 a 120
INTERVALO_SEGUNDOS=60
# TOLERANCIA_SEGUNDOS: 60 a 3600 e >= INTERVALO_SEGUNDOS
TOLERANCIA_SEGUNDOS=180
# LEMBRETE_HORARIO: HH:MM no fuso TZ
LEMBRETE_HORARIO=08:00
TZ=America/Sao_Paulo
STATE_DIR=/data
LOG_LEVEL=INFO
